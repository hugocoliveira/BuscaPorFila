<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão de câmera para leitura de QR Code -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Feature de câmera (não obrigatória — app funciona sem câmera física) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@null"
        android:label="@string/app_name"
        android:roundIcon="@null"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuscaPorFila">

        <!--
            MainActivity é a única activity.
            NÃO há intent-filter LAUNCHER — o app não aparece no launcher do dispositivo.
            É lançado exclusivamente via Intent explícita pelo MenuAutomatico.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Sem intent-filter LAUNCHER: ícone não aparece para o usuário final -->
        </activity>

        <!--
            Alias expõe o componente como br.com.lit.busca.fila.MainActivity,
            que é o ComponentName que o MenuAutomatico usa na Intent explícita.
        -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".ui.MainActivity"
            android:exported="true" />

    </application>

</manifest>
